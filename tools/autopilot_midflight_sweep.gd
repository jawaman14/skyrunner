extends SceneTree
## Turn the autopilot on in mid-flight from many random situations and report which cases it flies safely.
##
##   godot --headless --path . --script res://tools/autopilot_midflight_sweep.gd -- [--cases 120] [--seed 7] [--out docs/AUTOPILOT_MIDFLIGHT.md]
##
## Each case: a random position over the island, heading, height above the ground (120-1500 m), speed (70-130 kt), and a random manoeuvre in
## progress (level, banked, climbing, descending: a few seconds of stick before U). Then one of three presses:
##   hold      U once: the plain course-and-altitude hold. SAFE if it is still flying and clear of the ground for 4 minutes.
##   route     U, U: the leg to an airfield. SAFE if it is still flying for 4 minutes and has not flown away from the field.
##   waypoint  U with a waypoint 8-25 km away (the chart's pin). SAFE if it arrives within 1.5 km, announced, or is closing on it after 8 minutes.
## A case FAILS if the aircraft crashes, the autopilot drops out, or a command is refused. The random draws come from a fixed seed: the same
## seed gives the same cases. Slow, so a tool and not part of the test suite. Exit code 0; the report is the result.


func _initialize() -> void:
	var cases := 120
	var seed_ := 7
	var out := ""
	var args := OS.get_cmdline_user_args()
	var i := 0
	while i < args.size():
		match args[i]:
			"--cases":
				i += 1
				cases = int(args[i])
			"--seed":
				i += 1
				seed_ = int(args[i])
			"--out":
				i += 1
				out = args[i]
		i += 1
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_
	var kinds: Array = ["hold", "route", "waypoint"]
	var rows: Array = []
	var bad := 0
	for n in cases:
		var r := _case(n, kinds[n % 3], rng)
		rows.append(r)
		if r.result != "SAFE":
			bad += 1
		print("%3d %-8s %s (%s)" % [n, r.kind, r.result, r.note])
	var lines := ["# Autopilot mid-flight sweep", "",
		"%d random mid-flight engagements (seed %d), %d not safe. Generated by `tools/autopilot_midflight_sweep.gd`." % [rows.size(), seed_, bad], "",
		"| # | press | start | result | detail |", "|---:|---|---|---|---|"]
	for r in rows:
		lines.append("| %d | %s | %s | %s | %s |" % [r.n, r.kind, r.start, r.result, r.note])
	var text := "\n".join(lines) + "\n"
	if out != "":
		var f := FileAccess.open(out, FileAccess.WRITE)
		f.store_string(text)
		f.close()
		print("wrote ", out)
	else:
		print(text)
	quit(0)


func _fly(s: Session, secs: float, throttle: float, held: Array) -> void:
	for i in int(secs * 30):
		var inp := ControlMapper.InputFrame.new()
		inp.throttle_axis = throttle
		for h in held:
			inp.held[h] = true
		s.update(1.0 / 30, inp, null)


func _case(n: int, kind: String, rng: RandomNumberGenerator) -> Dictionary:
	var s := Session.new({"seed": 9, "map_seed": MapCity.SEED, "location": "HAR", "ground_war": false, "trade": true})
	s.police.frozen = true
	var half := World.HALF * 0.85
	var x := rng.randf_range(-half, half)
	var y := rng.randf_range(-half, half)
	var hdg := rng.randf_range(0.0, 360.0)
	var agl := rng.randf_range(120.0, 1500.0)
	var kts := rng.randf_range(70.0, 130.0)
	s.spawn_airborne(x, y, hdg, maxf(s.world.ground(x, y), 0.0) + agl, kts)
	s.log.departed_from = "HAR"
	var manoeuvres: Array = ["level", "bank", "climb", "descend"]
	var manoeuvre: String = manoeuvres[rng.randi() % 4]
	var held: Array = []
	match manoeuvre:
		"bank":
			held = ["roll_left"] if rng.randf() < 0.5 else ["roll_right"]
		"climb":
			held = ["pitch_up"]
		"descend":
			held = ["pitch_down"]
	if not held.is_empty():
		_fly(s, rng.randf_range(2.0, 6.0), 0.8, held)
	var start := "%s, %.0f m up, %.0f kt, %.0f deg, (%.0f, %.0f)" % [manoeuvre, s.state.agl, s.state.ias_kts, s.state.heading, s.state.x, s.state.y]
	if s.phase == "crashed":
		s.dispose()
		return {"n": n, "kind": kind, "start": start, "result": "SKIP", "note": "crashed during the set-up manoeuvre"}
	var args := {}
	var wp := [0.0, 0.0]
	if kind == "waypoint":
		var bearing := deg_to_rad(rng.randf_range(0.0, 360.0))
		var dist := rng.randf_range(8000.0, 25000.0)
		wp = [clampf(s.state.x + sin(bearing) * dist, -half, half), clampf(s.state.y + cos(bearing) * dist, -half, half)]
		if PyMath.hypot(wp[0] - s.state.x, wp[1] - s.state.y) < 4000.0:  # clamped at the island edge: too close to be a leg, so aim the other way
			bearing += PI
			wp = [clampf(s.state.x + sin(bearing) * dist, -half, half), clampf(s.state.y + cos(bearing) * dist, -half, half)]
		args = {"waypoint": wp}
	var r1: Array = s.command(Roles.PILOT, "autopilot", args)
	var r2: Array = [true, "ok"]
	if kind == "route":
		r2 = s.command(Roles.PILOT, "autopilot", {})
	if not (r1[0] and r2[0]):
		s.dispose()
		return {"n": n, "kind": kind, "start": start, "result": "FAILS", "note": "command refused: %s %s" % [r1[1], r2[1]]}
	var secs := 480.0 if kind == "waypoint" else 240.0
	var d0 := PyMath.hypot(wp[0] - s.state.x, wp[1] - s.state.y)
	var min_agl := 1e9
	var result := "SAFE"
	var note := ""
	var announced := false
	while secs > 0.0:
		var step := 5.0
		_fly(s, step, 0.8, [])
		secs -= step
		if s.state != null and not s.state.on_ground:
			min_agl = minf(min_agl, s.state.agl)
		if s.phase == "crashed":
			result = "FAILS"
			note = "crashed with %.0f s left, %.0f m up, lowest so far %.0f m" % [secs, s.state.agl, min_agl]
			break
		if not s.messages.is_empty():
			var m := str(s.messages.back()[1])
			if "over your waypoint" in m or "over the field" in m:
				announced = true
		if kind == "waypoint" and PyMath.hypot(wp[0] - s.state.x, wp[1] - s.state.y) < 1500.0:
			break
		if not s.autopilot.engaged and not announced:
			result = "FAILS"
			note = "autopilot dropped out"
			break
	if result == "SAFE":
		note = "lowest %.0f m above ground" % min_agl
		if kind == "waypoint":
			var d1 := PyMath.hypot(wp[0] - s.state.x, wp[1] - s.state.y)
			if d1 >= 1500.0 and d1 > d0 - 3000.0:
				result = "FAILS"
				note = "not closing on the waypoint: %.1f km of %.1f km left" % [d1 / 1000.0, d0 / 1000.0]
			else:
				note = "%.1f km left of %.1f km; %s" % [d1 / 1000.0, d0 / 1000.0, note]
	s.dispose()
	return {"n": n, "kind": kind, "start": start, "result": result, "note": note}
