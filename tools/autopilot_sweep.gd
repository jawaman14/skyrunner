extends SceneTree
## Fly the autopilot between every ordered pair of airfields and report which legs arrive.
##
##   godot --headless --path . --script res://tools/autopilot_sweep.gd -- [--map city|N] [--start cruise|liftoff|both] [--out docs/AUTOPILOT_SWEEP.md] [--minutes 25]
##
## For each pair A -> B the session starts at A with a cargo job for B on board, the aircraft airborne near A on the way to B
## (cruise: 450 m up, 3 km out, heading for B; liftoff: 25 m up over the strip's centre on the runway heading, as if just off the ground), then U, U (hold, then route). A leg
## ARRIVES when the autopilot says it is over the field (the join/final flown), FAILS when the aircraft crashes, and TIMES OUT otherwise.
## Slow (dozens of simulated flights), so it is a tool, not part of the test suite. Exit code 0; the report is the result.

const FT := 0.3048


func _initialize() -> void:
	var map_id := 0
	var start := "both"
	var out := ""
	var minutes := 25.0
	var args := OS.get_cmdline_user_args()
	var i := 0
	while i < args.size():
		match args[i]:
			"--map":
				i += 1
				map_id = MapCity.SEED if args[i] == "city" else int(args[i])
			"--start":
				i += 1
				start = args[i]
			"--out":
				i += 1
				out = args[i]
			"--minutes":
				i += 1
				minutes = float(args[i])
		i += 1
	var starts: Array = ["cruise", "liftoff"] if start == "both" else [start]
	var codes: Array = []
	for af in World.AIRFIELDS:
		codes.append(af.code)
	var rows: Array = []
	var bad := 0
	for mode in starts:
		for a in codes:
			for b in codes:
				if a == b:
					continue
				var r := _leg(a, b, mode, minutes)
				rows.append(r)
				if r.result != "ARRIVES":
					bad += 1
				print("%s %s -> %s: %s (%s)" % [mode, a, b, r.result, r.note])
	var lines := ["# Autopilot sweep: every ordered pair of airfields", "",
		"%d legs (%s start), %d did not arrive. Generated by `tools/autopilot_sweep.gd`; sim time limit %s min per leg." % [rows.size(), start, bad, minutes], "",
		"| start | from | to | result | detail |", "|---|---|---|---|---|"]
	for r in rows:
		lines.append("| %s | %s | %s | %s | %s |" % [r.mode, r.a, r.b, r.result, r.note])
	var text := "\n".join(lines) + "\n"
	if out != "":
		var f := FileAccess.open(out, FileAccess.WRITE)
		f.store_string(text)
		f.close()
		print("wrote ", out)
	else:
		print(text)
	quit(0)


func _leg(a: String, b: String, mode: String, minutes: float) -> Dictionary:
	var s := Session.new({"seed": 9, "map_seed": MapCity.SEED, "location": a, "ground_war": false, "trade": true})
	s.police.frozen = true
	var from := World.airfield(a)
	var to := World.airfield(b)
	s.active_jobs.append(Jobs.Job.new(Jobs.new_id(), "sweep", "cargo", a, b, [], 100, {}))
	## cruise: heading straight for the destination. liftoff: along the runway, as a real take-off leaves the ground (the autopilot then has to turn).
	var hdg: float = PilotBot.bearing(from.x, from.y, to.x, to.y)
	if mode == "liftoff":
		# depart over the clear end, as a pilot does at a one-way strip: the ground ahead is the approach of the end we fly towards
		hdg = from.heading if (s.approach_end_clear(from, 1) or not s.approach_end_clear(from, 0)) else Py.wrap180(from.heading + 180.0)
	var agl := 450.0 if mode == "cruise" else 25.0
	var out_m := 3000.0 if mode == "cruise" else 0.0
	var h := deg_to_rad(hdg)
	var px := from.x + sin(h) * out_m
	var py := from.y + cos(h) * out_m
	s.spawn_airborne(px, py, hdg, maxf(s.world.ground(px, py), s.world.airfield_elev(from)) + agl, 80.0 if mode == "liftoff" else 95.0)  # metres above SEA level
	s.log.departed_from = a
	var r1: Array = s.command(Roles.PILOT, "autopilot", {})
	var r2: Array = s.command(Roles.PILOT, "autopilot", {})
	var result := "TIMES OUT"
	var note := ""
	var min_agl := 1e9
	var t_end := minutes * 60.0
	var dt := 1.0 / 30
	var arrived := false
	while s.time < t_end:
		var inp := ControlMapper.InputFrame.new()
		inp.throttle_axis = 0.8
		s.update(dt, inp, null)
		if s.state != null and not s.state.on_ground:
			min_agl = minf(min_agl, s.state.agl)
		if s.phase == "crashed":
			result = "FAILS"
			note = "crashed at %.0f s, %.1f km from %s, %.0f m up" % [s.time, PyMath.hypot(s.state.x - to.x, s.state.y - to.y) / 1000.0, b, s.state.agl]
			break
		if not s.messages.is_empty() and "over the field" in str(s.messages.back()[1]):
			arrived = true
			break
		if not s.autopilot.engaged:
			note = "autopilot dropped out"
			result = "FAILS"
			break
	if arrived:
		result = "ARRIVES"
		note = "%.0f s; lowest %.0f m above ground" % [s.time, min_agl]
	elif result == "TIMES OUT":
		note = "%.1f km short of %s after %.0f min" % [PyMath.hypot(s.state.x - to.x, s.state.y - to.y) / 1000.0, b, minutes]
	if not (r1[0] and r2[0]):
		note += " (command refused: %s %s)" % [r1[1], r2[1]]
	s.dispose()
	return {"mode": mode, "a": a, "b": b, "result": result, "note": note}
